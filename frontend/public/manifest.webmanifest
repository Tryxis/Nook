{
  "id": "/",
  "name": "Nook",
  "short_name": "Nook",
  "description": "A reading diary: track what you read, rate in half stars, bookmark pages and share reviews.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#064c37",
